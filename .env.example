# Deployment profile. Safe default when omitted is production.
# development: explicit local conveniences may be enabled below.
# test: deterministic isolated automation.
# demo: public portfolio deployment; real Jira and developer identity are forbidden.
# production: future enterprise deployment with fail-closed defaults.
KNOWVIA_ENVIRONMENT=development
KNOWVIA_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
KNOWVIA_DEBUG=false
KNOWVIA_ENABLE_HSTS=false
# All mutable databases, audit data, and the runtime vector index live here.
KNOWVIA_DATA_DIR=data
# Immutable deployment inputs; container defaults are documented separately.
KNOWVIA_DOCUMENTS_DIR=knowvia_m1_dataset
KNOWVIA_BUNDLED_INDEX=data/knowvia_index.json

# Local embeddings are the default and do not require an API key.
KNOWVIA_EMBEDDING_PROVIDER=local
# Optional pinned FP32 ONNX runtime: install .[onnx], prepare assets explicitly,
# then select onnx and set KNOWVIA_ONNX_MODEL_DIR to the prepared directory.
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# M2 local answer generation through Ollama.
KNOWVIA_GENERATION_PROVIDER=ollama
OLLAMA_GENERATION_MODEL=llama3.2:latest
OLLAMA_HOST=http://localhost:11434

# M3 fail-closed evidence-sufficiency gate.
KNOWVIA_EVIDENCE_EVALUATOR=ollama
OLLAMA_EVIDENCE_MODEL=llama3.2:latest

# Optional OpenAI provider settings. Never commit a real API key.
OPENAI_API_KEY=your-api-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# M6 optional Gemini router. The deterministic router remains the default.
KNOWVIA_AGENT_ROUTER=deterministic
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_ROUTER_MODEL=gemini-3.6-flash
GEMINI_ROUTER_TIMEOUT_SECONDS=30

# M6 tool selection. Keep mock unless intentionally testing Jira proposals.
KNOWVIA_AGENT_TOOL=mock
# Real Jira is never enabled merely because credentials are present. Private
# development/enterprise deployments must explicitly opt in server-side.
KNOWVIA_ENABLE_REAL_JIRA_MUTATIONS=false
# Local development/testing selector only. This is not authentication or SSO.
KNOWVIA_IDENTITY=employee-001
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_USER_EMAIL=developer@example.com
JIRA_API_TOKEN=your-jira-api-token-here
JIRA_PROJECT_KEY=IT
JIRA_ISSUE_TYPE=Task
JIRA_TIMEOUT_SECONDS=15

# M11 local stdio MCP adapter. MCP wraps the existing mock or Jira backend.
# Keep mock unless intentionally testing the existing Jira confirmation flow.
KNOWVIA_MCP_TICKET_BACKEND=mock
KNOWVIA_MCP_TIMEOUT_SECONDS=15

# M13 local employee web application.
# Keep the default loopback host unless you intentionally configure a trusted
# network boundary. The identity selector is demonstration-only, not SSO.
KNOWVIA_WEB_HOST=127.0.0.1
KNOWVIA_WEB_PORT=8000
# Production entrypoint uses the hosting platform's PORT instead.
PORT=8000

# M14.3 authenticated web mode. Production defaults must keep Secure cookies
# enabled and browser-supplied development identities disabled.
KNOWVIA_AUTH_COOKIE_SECURE=true
KNOWVIA_ALLOW_DEVELOPMENT_IDENTITY_OVERRIDE=false
KNOWVIA_SEED_DEMO_EMPLOYEE_DIRECTORY=false
KNOWVIA_REGISTRATION_ENABLED=false
KNOWVIA_ALLOW_DEVELOPER_DETAILS=false
