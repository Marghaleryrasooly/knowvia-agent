# Non-secret public portfolio-demo settings.
KNOWVIA_ENVIRONMENT=demo
KNOWVIA_ALLOWED_HOSTS=knowvia-demo.example.com
KNOWVIA_AUTH_COOKIE_SECURE=true
KNOWVIA_ALLOW_DEVELOPMENT_IDENTITY_OVERRIDE=false
KNOWVIA_SEED_DEMO_EMPLOYEE_DIRECTORY=true
KNOWVIA_REGISTRATION_ENABLED=true
KNOWVIA_ALLOW_DEVELOPER_DETAILS=false
KNOWVIA_DEBUG=false
KNOWVIA_ENABLE_HSTS=true

# Safe fictional ticketing. Never enable Jira in a public demo.
KNOWVIA_AGENT_TOOL=mock
KNOWVIA_MCP_TICKET_BACKEND=mock
KNOWVIA_ENABLE_REAL_JIRA_MUTATIONS=false

# Gemini routes requests; the key is supplied by the platform secret store.
KNOWVIA_AGENT_ROUTER=gemini
GEMINI_ROUTER_MODEL=gemini-3.6-flash
GEMINI_ROUTER_TIMEOUT_SECONDS=30
GEMINI_API_KEY=SET_IN_PLATFORM_SECRET_STORE

# Frozen M1-M14 knowledge architecture.
KNOWVIA_EMBEDDING_PROVIDER=local
# Opt-in lean image: build with --build-arg EMBEDDING_PROVIDER=onnx,
# then set KNOWVIA_EMBEDDING_PROVIDER=onnx (never enables real Jira).
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
KNOWVIA_GENERATION_PROVIDER=ollama
KNOWVIA_EVIDENCE_EVALUATOR=ollama
OLLAMA_GENERATION_MODEL=llama3.2:latest
OLLAMA_EVIDENCE_MODEL=llama3.2:latest
OLLAMA_HOST=SET_TO_SERVER_SIDE_OLLAMA_ENDPOINT

# Hosting platform/mounted-volume paths.
KNOWVIA_DATA_DIR=/var/lib/knowvia
KNOWVIA_DOCUMENTS_DIR=/opt/knowvia/knowledge
KNOWVIA_BUNDLED_INDEX=/opt/knowvia/bootstrap/knowvia_index.json
